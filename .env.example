# Copy to .env to override defaults used by docker-compose.yml
POSTGRES_USER=retail
POSTGRES_PASSWORD=retail
TRAIN_API_KEY=local-dev-train-key

# Host ports
FRONTEND_PORT=3000
API_PORT=8000
AIRFLOW_PORT=8080
MLFLOW_PORT=5000
ODATA_PORT=8081
POSTGRES_PORT=5432

# Airflow (local development defaults; change for anything shared)
AIRFLOW_ALL_ADMINS=True
AIRFLOW_JWT_SECRET=change-me-local-dev-jwt-secret
AIRFLOW_SECRET_KEY=change-me-local-dev-secret
AIRFLOW_FERNET_KEY=

# Data source / pipeline
MOCK_PRODUCTS=80
# MOCK_AS_OF=2026-11-04      # pin the simulated "today" (default: yesterday)
ETL_MAX_INVALID_RATIO=0.05

# Forecasting
FORECAST_HORIZON=30
BACKTEST_FOLDS=3
DEMAND_MODELS=xgboost,prophet
ML_N_JOBS=4
